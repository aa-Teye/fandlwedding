# Copy to .env.local for local use. Add these separately in Vercel settings.
# Neon Postgres connection string (the pooled one)
DATABASE_URL=
# Long random secret for the couple's guest list page: /guests?key=...
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GUESTS_KEY=
# The final public address, used for link previews. Use localhost locally.
NEXT_PUBLIC_SITE_URL=http://localhost:1912
